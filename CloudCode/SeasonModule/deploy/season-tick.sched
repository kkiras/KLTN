{
  "$schema": "https://ugs-config-schemas.unity3d.com/v1/schedules.schema.json",
  "Configs": {
    "season-tick": {
      "EventName": "season-tick",
      "Type": "recurring",
      "Schedule": "0 * * * *",
      "PayloadVersion": 1,
      "Payload": "{\"durationHours\": 24, \"lockMinutes\": 30}"
    }
  }
}
